# ── 秘钥 ──────────────────────────────────────────────
# 绝不提交。四个训记 API key 都在这里。
.env
.env.local
*.key

# ── 私人健康数据 ──────────────────────────────────────
# 训练记录、体重体脂、饮食日志、个人档案、病史用药、聊天记录归档。
#
# profile/ 里是**只属于你一个人**的东西：病史、用药、体检数值、忌口、作息。
# knowledge/ 里是**任何人都能用**的通用知识：动作分类、训练量参考、人格、安全边界。
# 这条分界线决定了这个仓库能不能安全地公开分享。
profile/*
# 模板要提交，供其他人参照填写（注意：.gitignore 不支持行尾注释）
!profile/*.example.md
chat-history/
# knowledge/ 根目录是**白名单**：只有下面这六个区 + README 进版本库。
# 其余一律当成私人资料忽略掉 —— 这是有意的，不是防御性的。
# 整套现成的知识库（教材、课程包、文献库）就该原样丢在 knowledge/ 根上，
# 白名单保证它们不会被误提交。零散单份资料进 knowledge/library/。
knowledge/*
!knowledge/README.md
!knowledge/coach/
!knowledge/measurement/
!knowledge/movements/
!knowledge/training/
!knowledge/nutrition/
!knowledge/library/
# knowledge/library/ 是你自己的专业资料（教材、课程、笔记）。
# 只提交目录骨架、README 和 INDEX 模板，内容一律留在本地。
knowledge/library/*
!knowledge/library/README.md
!knowledge/library/INDEX.example.md
!knowledge/library/*/
knowledge/library/*/*
!knowledge/library/*/.gitkeep
# 想跨设备同步的话，在 data/ 里单独 init 一个私有仓库，
# 或者用 `hc export` 打包带走。详见 README。
data/

# ── 生成物 ────────────────────────────────────────────
reports/

# ── install.sh 生成的宿主软链 ─────────────────────────
# skills/ 才是真相源；这些只是链到宿主期望位置的软链，
# 换台机器跑一次 ./install.sh 就会重建，提交了反而会在别人机器上变成死链。
.claude/skills/
.codex/skills/
.cursor/rules/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── 编辑器 / 系统 ─────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
