# ── 秘钥 ──────────────────────────────────────────────
# 绝不提交。四个训记 API key 都在这里。
.env
.env.local
*.key

# ── 私人健康数据 ──────────────────────────────────────
# 训练记录、体重体脂、饮食日志、个人档案。
# 想跨设备同步的话，在 data/ 里单独 init 一个私有仓库，
# 或者用 `hc export` 打包带走。详见 README。
data/

# ── 生成物 ────────────────────────────────────────────
reports/

# ── 嵌套的无关仓库 ────────────────────────────────────
xeo-fitness/

# ── install.sh 生成的宿主软链 ─────────────────────────
# skills/ 才是真相源；这些只是链到宿主期望位置的软链，
# 换台机器跑一次 ./install.sh 就会重建，提交了反而会在别人机器上变成死链。
.claude/skills/
.codex/skills/
.cursor/rules/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── 编辑器 / 系统 ─────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
