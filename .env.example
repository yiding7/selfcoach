# 训记 (Xunji) Open API 凭证
# ─────────────────────────────────────────────────────────────
# 复制这个文件为 .env，然后填入你自己的 key：
#     cp .env.example .env
#
# key 在训记 App 里申请（需要会员）。四个 key 用途不同，
# 缺哪个就只是对应模块不可用，不影响其它功能。
#
# ⚠️ 完全没有训记也能用：留空即可，工具会自动切到手记模式。
#    见 README 的「没有训记怎么办」。

# 训练记录读写 + 官方训练计划读取
# 用于: trains.xunjiapp.cn/api_trains_for_llm_v2
#       api.xunjiapp.cn/open/plan/query_gzip
XUNJI_TRAIN_KEY=xjllm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 饮食记录读写 + 自定义食物 + 饮食模板
# 用于: eatings.xunjiapp.cn/open/food/*
XUNJI_FOOD_KEY=xjfood_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 官方食物库搜索 —— 注意这是独立的一把 key，和上面那个不通用
# 用于: api.xunjiapp.cn/open_agent/food/search_gzip
XUNJI_FOOD_SEARCH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 身体数据读写（体重 / 体脂 / 围度）
# 用于: api.xunjiapp.cn/open/body/*
XUNJI_BODY_KEY=xjbody_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# 可选：无人值守出报告用的 LLM 适配器
# ─────────────────────────────────────────────────────────────
# 只有在你想用 cron 定时生成周报时才需要。
# 平时在 Claude Code / Codex / Cursor 里用的话，宿主自带模型，这里可以全部留空。
#
# 支持任何 OpenAI 兼容端点（DeepSeek / Kimi / 通义 / 智谱 / Ollama / vLLM …）
# 以及 Anthropic 原生端点。
# HC_LLM_PROVIDER=openai-compatible   # 或 anthropic
# HC_LLM_BASE_URL=https://api.deepseek.com/v1
# HC_LLM_MODEL=deepseek-chat
# HC_LLM_API_KEY=
