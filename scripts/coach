#!/usr/bin/env bash
# 桌面快捷方式的启动逻辑。
#
# 桌面上那个 .command 只是三行的壳，真正的东西在这里 ——
# 想改启动行为改这个文件就够了，不用动桌面上那个。
#
# 用法：
#   scripts/coach            数据新鲜度 + 启动一个**新**的 Claude Code 会话
#   scripts/coach -c         接着上一次的对话（同一件事没聊完时用）
#   scripts/coach --resume   列出历史会话让你挑一个
#   scripts/coach --status   只看新鲜度，不启动 agent（也用来自测）
#   scripts/coach --shell    不启动 agent，直接给个在项目目录里的 shell
#   scripts/coach --persona-hint
#                            只打印会注入 system prompt 的语气/称呼那几行（自测用）
#
# 除了 --status / --shell / --persona-hint，其余参数一律原样透传给 claude。
#
# 为什么默认开新会话：这个项目的事实都在 data/ profile/ knowledge/ 里，
# 不在对话里。长会话会被压缩、会丢细节，而档案不会。聊出来的重要结论
# 应该写进 profile/，而不是指望 agent 记着。
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"

# Finder 双击启动时 PATH 往往不完整，把常见位置补上
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

MODE="${1:-}"

# 当前语气 + 称呼 → 注入 system prompt 的那几行。
#
# 只注指路的一两行，不注全文：语气文件几百行，塞进 system prompt 是浪费；
# agent 读完 persona.md 自然会顺着这一行去打开对应那份。这里解决的只是
# 「它不知道选了哪个」和「它不知道该怎么叫他」。
#
# 字段走 `hc persona --json` 这个机器可读接口。**不要回去 sed
# `hc persona` 的展示文本** —— 那份清单是给人看的，措辞随时会调，
# 而 sed 抠不到时只会安静地给出空串：整段称呼提示消失，屏幕上一个字的错都没有，
# agent 于是退回「不知道该怎么称呼」甚至自己编一个 —— 正是这段代码想防的事。
#
# 提示走 stdout（要注入的东西），告警走 stderr（给人看的）。
persona_hint() {
  local py="${PYTHON:-python3}"
  local json="" fields="" tone="" address="" state="" warn=""

  if json="$("$HERE/scripts/hc" persona --json 2>/dev/null)"; then
    fields="$(printf '%s' "$json" | "$py" -c '
import json, sys
d = json.load(sys.stdin)
addrs = d.get("addresses") or []
print(d.get("tone_label") or "")
print("、".join(addrs))
print("has" if addrs else ("empty" if d.get("address_set") else "unset"))
print(" / ".join(d.get("warnings") or []))
' 2>/dev/null || true)"
  fi
  if [ -n "$fields" ]; then
    {
      IFS= read -r tone
      IFS= read -r address
      IFS= read -r state
      IFS= read -r warn
    } <<<"$fields"
  fi

  [ -n "$warn" ] && printf '  ⚠️  %s\n' "$warn" >&2
  if [ -z "$tone" ]; then
    # 拿不到就说出来。这一段悄悄消失正是要防的事。
    printf '  ⚠️  拿不到教练语气和称呼（hc persona --json 没跑通）——\n' >&2
    printf '      这次不给 agent 注入这两条提示，跑一下 ./scripts/hc doctor 看看\n' >&2
    return 0
  fi

  printf '当前教练语气：%s。读完 knowledge/coach/persona.md 后，接着读它指向的 knowledge/coach/personas/ 里对应那一份。语气只改措辞，不改结论。\n' "$tone"
  # 称呼**空是合法答案**，那种情况下要明确说「不要称呼」—— 什么都不注入的话
  # agent 看不到任何指示，反而可能自己编一个。而「明确不要」和「还没问过」
  # 是两回事，给 agent 的指示也不一样，不能合成一句。
  case "$state" in
    has)
      printf '称呼：%s（真相源 data/profile.json 的 address，多个时第一个是默认）。\n' "$address" ;;
    empty)
      printf '称呼：用户明确选了不要称呼（data/profile.json 的 address 是空的）。直接说事，不要自己想一个。\n' ;;
    *)
      printf '称呼：还没问过（data/profile.json 里没有 address 字段）。先直接说事，不要自己想一个；聊到合适的时候请他跑一次 hc setup。\n' ;;
  esac
}

# 自测入口：只算语气/称呼提示，不打新鲜度、不启动 agent。
# 放在最前面是为了让它便宜到可以在单元测试里跑。
if [ "$MODE" = "--persona-hint" ]; then
  persona_hint
  exit 0
fi

# 终端窗口标题
printf '\033]0;%s\007' "健康教练"

printf '\n\033[1m健康教练\033[0m  ·  %s\n' "$HERE"
printf '%s\n\n' "────────────────────────────────────────────────"

# 数据新鲜度：不联网，秒回
if ! "$HERE/scripts/hc" status 2>&1; then
  printf '  ⚠️  hc status 没跑起来，跑一下 ./scripts/hc doctor 看看环境\n'
fi

# 教练日志：也是本地读取，秒回。这里打出来是给**你**看的 ——
# 上次挂着没闭合的问题，进屋前先扫一眼。
printf '\n'
"$HERE/scripts/hc" journal 2>/dev/null || true

printf '\n%s\n' "────────────────────────────────────────────────"

case "$MODE" in
  --status)
    exit 0
    ;;
  --shell)
    printf '\n当前目录 %s，可以直接用 ./scripts/hc …\n\n' "$HERE"
    exec "${SHELL:-/bin/zsh}" -i
    ;;
esac

CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
if [ -n "$CLAUDE_BIN" ]; then
  if [ "$#" -gt 0 ]; then
    printf '\n正在启动 Claude Code（%s），退出后会留在项目目录里…\n\n' "$*"
  else
    printf '\n正在启动 Claude Code（新会话），退出后会留在项目目录里…\n'
    printf '想接上次的对话：退出后跑 ./scripts/coach -c\n\n'
  fi

  # 把教练日志直接塞进 system prompt。
  #
  # 为什么在这里做而不是让 agent 自己跑命令：每次对话开头多一次工具调用，
  # 就多一次权限确认和一个来回，聊天就不像聊天了。日志是本地读取、毫秒级、
  # 且**只读无副作用**，完全可以在启动时一次性注入。
  #
  # 注入的块带 <coach-journal> 哨兵，agent 看到它就知道不用再读一遍。
  JOURNAL_BRIEF="$("$HERE/scripts/hc" journal --brief 2>/dev/null || true)"

  # 语气和称呼见上面 persona_hint()（告警会直接打到屏幕上）
  TONE_HINT="$(persona_hint)"

  PREAMBLE="$(printf '%s\n\n%s' "$JOURNAL_BRIEF" "$TONE_HINT")"
  if [ -n "$JOURNAL_BRIEF" ] || [ -n "$TONE_HINT" ]; then
    "$CLAUDE_BIN" --append-system-prompt "$PREAMBLE" "$@" || true
  else
    "$CLAUDE_BIN" "$@" || true
  fi
  printf '\n已退出 Claude Code。当前目录 %s，可以直接用 ./scripts/hc …\n\n' "$HERE"
else
  printf '\n⚠️  PATH 里没找到 claude 命令，直接给你一个在项目目录里的 shell。\n\n'
fi

# 不关窗口，留在项目目录继续用 hc
exec "${SHELL:-/bin/zsh}" -i
